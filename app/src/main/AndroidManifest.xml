<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau local uniquement : aucun service tiers de mesure d'audience. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Verrou multicast : réception des réponses mDNS / SSDP / GDM pendant la découverte. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      Lecture du nom du réseau Wi-Fi (SSID) pour la restriction « réseaux autorisés » d'un
      appareil : Android l'exige. Demandée à l'exécution uniquement quand l'utilisateur saisit
      des SSID ; la position n'est jamais lue. COARSE accompagne FINE (exigence Android 12+).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Caméra : scan d'un QR code d'import d'appareils (scanner ZXing embarqué, hors ligne).
      Demandée à l'exécution, uniquement au moment du scan. Facultative : l'application reste
      installable sur les appareils sans caméra (TV, boîtiers), où le scan est masqué.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Partage d'un fichier du téléphone vers la télévision : service au premier plan (type
      lecture multimédia) tant que le fichier est servi, avec sa notification « Arrêter ».
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!--
      Non demandées volontairement :
      - NEARBY_WIFI_DEVICES : réservée au Wi-Fi Direct / Aware et au scan Wi-Fi ; NsdManager
        et les sockets multicast n'en ont pas besoin.
      - Accès au réseau local (Android 16+) : la restriction n'est appliquée qu'aux
        applications ciblant une API supérieure à 36. À traiter (permission d'exécution) le
        jour où targetSdk passera à 37.
    -->

    <application
        android:name=".ZapetteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zapette"
        tools:targetApi="36">

        <service
            android:name=".data.LocalShareService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- « Partager vers Zapette » : envoie un lien vers l'appareil courant. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
