<?xml version="1.0" encoding="utf-8"?>
<!--
  Kodi, UPnP, Roku, AirPlay et les serveurs locaux parlent HTTP en clair sur le réseau
  local : le trafic non chiffré reste autorisé, mais il est interdit vers plex.tv.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <!--
          Seules les autorités de certification SYSTÈME sont reconnues, choix volontaire : les CA
          « utilisateur » installées dans les réglages Android ne sont pas acceptées (une CA
          ajoutée par un profil d'entreprise, un logiciel ou un tiers pourrait sinon intercepter
          les mots de passe et jetons). Conséquence : un Kodi / Jellyfin / Emby en HTTPS avec un
          certificat signé par une CA maison échoue en mode « HTTPS » vérifié. Utiliser alors
          le mode « HTTPS non vérifié » du formulaire, qui épingle l'empreinte du certificat
          (confiance au premier usage, appareil par appareil). Ne pas ajouter
          <certificates src="user" /> sans raison forte.
        -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">plex.tv</domain>
    </domain-config>
</network-security-config>
